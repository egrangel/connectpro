// PostgreSQL everywhere (dev and production/Vercel) — see docs/ARCHITECTURE.md §4
// and README "Banco de dados". The schema deliberately sticks to portable
// features (string roles/statuses, JSON-as-string) inherited from the original
// SQLite setup, so no data-shape migration was needed for the provider swap.

generator client {
  provider = "prisma-client-js"
}

// `url` is Neon's pooled endpoint (PgBouncer) — right for the app's short,
// serverless queries. `directUrl` must NOT be pooled: `prisma migrate` takes a
// session-level advisory lock, and PgBouncer's transaction pooling never pins a
// session to one backend, so the lock times out (P1002) and the deploy fails.
// Migrations therefore run against the direct endpoint; the app still pools.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// role: "USER" | "ADMIN" — string by design for portability (see src/lib/constants.ts)
model User {
  id             String               @id @default(uuid())
  email          String               @unique
  passwordHash   String
  displayName    String
  role           String               @default("USER")
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  // When this account accepted the consent agreement. Nullable because accounts
  // created before the agreement existed never saw one — recording "now" for
  // them would be inventing a consent that was never given.
  termsAcceptedAt DateTime?
  sessions       Session[]
  reviews        Review[]
  listings       Listing[]
  passwordResets PasswordResetToken[]
}

// Single-use password reset grant. Only the SHA-256 hash of the token is
// stored — the raw value exists solely inside the emailed link, so a database
// leak cannot be replayed to take over accounts. Rows are deleted on
// redemption (never marked "used"), and every outstanding row for a user is
// dropped whenever a new one is issued or the password changes.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  listings  Listing[]
}

// status: "DRAFT" | "PUBLISHED" | "ARCHIVED"
// searchText: lowercase, accent-stripped title+description, maintained by the
// listings service — the portable stand-in for Postgres tsvector.
model Listing {
  id              String         @id @default(uuid())
  slug            String         @unique
  title           String
  description     String
  searchText      String         @default("")
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  contactPhone    String?
  contactEmail    String?
  contactWhatsapp String?
  // Bare handle, no "@" and no URL — see src/modules/listings/instagram.ts.
  instagram       String?
  websiteUrl      String?
  city            String?
  status          String         @default("DRAFT")
  ratingAvg       Float          @default(0)
  ratingCount     Int            @default(0)
  createdById     String
  createdBy       User           @relation(fields: [createdById], references: [id])
  photos          ListingPhoto[]
  reviews         Review[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, categoryId, createdAt])
  @@index([status, ratingAvg])
}

model ListingPhoto {
  id         String  @id @default(uuid())
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  storageKey String
  altText    String?
  sortOrder  Int     @default(0)

  @@index([listingId, sortOrder])
}

// rating: 1..5, enforced in src/modules/reviews (SQLite CHECK not expressible in Prisma)
// status: "VISIBLE" | "HIDDEN"
model Review {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  status    String   @default("VISIBLE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, userId])
  @@index([listingId, status, createdAt])
}

// Search analytics, aggregated: one row per normalized term (see `searchTerms`
// in src/lib/text.ts), incremented on every public search. Deliberately a
// counter and not a log — no user, session, IP or timestamp of the individual
// search is stored, so the report carries no personal data and the table stays
// bounded by vocabulary size instead of by traffic.
model SearchTermStat {
  term      String   @id
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([count])
}

// Singleton row (id always 1). JSON stored as validated strings because the
// SQLite connector lacks a native Json type; Zod schemas in
// src/modules/settings/schema.ts are the source of truth for their shape.
model SiteSettings {
  id           Int      @id @default(1)
  bannerJson   String   @default("{}")
  themeJson    String   @default("{}")
  brandingJson String   @default("{}")
  featuresJson String   @default("{}")
  termsJson    String   @default("{}")
  updatedAt    DateTime @updatedAt
}
