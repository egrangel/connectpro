# PostgreSQL connection string (dev and production).
# Free options for dev: Prisma Postgres, Neon, Supabase, or a local install.
DATABASE_URL="postgresql://user:password@localhost:5432/connect"

# Vercel Blob storage for uploaded photos (production/Vercel).
# Leave unset in development to store uploads on local disk (public/uploads/).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Absolute origin used to build links that leave the app (password reset
# e-mails). Never derived from the request Host header, which a client controls.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when unset.
# APP_BASE_URL="https://connect.example.com"

# Transactional e-mail (password reset) through Resend's HTTP API.
# Without RESEND_API_KEY the message — including the reset link — is printed to
# the server log instead of sent, which is enough for local development.
# RESEND_API_KEY="re_..."
# MAIL_FROM="Connect <no-reply@seu-dominio.com>"

# Used only by `npm run db:seed` to create the first admin account.
# There is NO self-service path to an admin account — registration always creates USER.
SEED_ADMIN_EMAIL="admin@connect.local"
SEED_ADMIN_PASSWORD="change-me"
